<mxCell id="cell_20" value="&lt;b&gt;AWS Transit Gateway (TGW) - Core Hub&lt;/b&gt;&lt;br&gt;• Multi-Account Hub: Network, DMZ, Internal, Kafka&lt;br&gt;• Centralized Private East-West Routing &amp; ECMP" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;arcSize=6;shadow=1;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=10;fontSize=10;fillColor=#FAF5FF;strokeColor=#8C4FFF;fontColor=#581C87;" vertex="1" parent="cell_15"><mxGeometry x="1020" y="435" width="840" height="105" as="geometry" /></mxCell>
