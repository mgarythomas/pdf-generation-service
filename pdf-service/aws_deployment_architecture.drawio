<mxCell id="cell_18" value="&lt;b&gt;Outbound / Egress F5 BIG-IP Cluster&lt;/b&gt;&lt;br&gt;• Egress Forward Proxy, Deep Packet Inspection&lt;br&gt;• NAT Gateway to SaaS: AEM, ABR, GLEIF, SF" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=1;arcSize=6;shadow=1;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=10;fontSize=10;fillColor=#FFF1F2;strokeColor=#CC2264;fontColor=#881337;" vertex="1" parent="cell_15"><mxGeometry x="540" y="445" width="430" height="85" as="geometry" /></mxCell>
